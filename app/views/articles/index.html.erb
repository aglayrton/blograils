<h1>Artigo</h1>
<br>
<%# @higth_lights[0] vai trazer o valor que está nessa key%>
<%= render_if @high_lights[0].present?, "longer_featured", article: @high_lights[0] %>

<div class="row mb-2">
  <%= render_if @high_lights[1].present?,"medium", article: @high_lights[1] %>
  <%= render_if @high_lights[2].present?, "medium", article: @high_lights[2]%>
</div>

<div class="row g-5">
  <div class="col-md-8">
    <h3 class="pb-4 mb-4 fst-italic border-bottom">
      From the firehose
    </h3>
    <div>
      <%= link_to "Criar artigo", new_article_path(), class:"btn btn-primary" %>
    </div>
    <%= render @articles %>
    <%= render "pagination" %>
  </div>
  <%= render "right_side" %>
</div>